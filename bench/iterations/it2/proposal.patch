+def types_of(species: str) -> list[str]:
+    try:
+        return list(D.species_types(species) or [])
+    except Exception:                                  # noqa: BLE001 (missing type data must not stop a run)
+        return []
+
+
+def move_value(name: str, attacker: str, foe_types: list[str]) -> tuple[float, str]:
+    """Code-side damage weight of a move (power × type multiplier × same-type bonus × accuracy) and its criterion text."""
+    try:
+        info = D.move_info(name)
+    except Exception:                                  # noqa: BLE001
+        info = None
+    if not info:
+        return 30.0, "damage unknown"
+    if not info["power"]:
+        return 0.0, "status move, deals no damage"
+    mult = D.type_multiplier(info["type"], foe_types) if foe_types else 1.0
+    stab = 1.5 if info["type"] in types_of(attacker) else 1.0
+    eff = ("has no effect on this foe" if mult == 0 else "super effective" if mult > 1
+           else "not very effective" if mult < 1 else "normal effectiveness")
+    return info["power"] * mult * stab * info["accuracy"] / 100, f"{info['type']} move, power {info['power']}, {eff}"
+
